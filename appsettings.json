{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/siap-.log", "rollingInterval": "Day" }
      }
    ]
  },
  "ChunkOptions": {
    "DefaultStrategy": "Paragraph",
    "MaxCharacters": 1000,
    "MaxTokens": 250,
    "OverlapCharacters": 100
  },
  "Ocr": {
    "Provider": "Tesseract",
    "ExecutablePath": "C:\\Users\\zreech\\scoop\\apps\\tesseract\\current\\tesseract.exe",
    "DataPath": "C:\\Users\\zreech\\scoop\\apps\\tesseract-languages\\current",
    "Language": "ind+eng"
  },
  "JwtOptions": {
    "Key": "this_is_a_very_long_secret_key_for_jwt_authentication_in_siap_app",
    "Issuer": "SIAP.Api",
    "Audience": "SIAP.Clients",
    "ExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 7
  },
  "Google": {
    "ClientId": ""
  }
}